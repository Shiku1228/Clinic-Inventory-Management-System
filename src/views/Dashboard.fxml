<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.DashboardController"
            styleClass="mainFxmlClass">

    <!-- ========== SIDEBAR ========== -->
    <left>
        <VBox fx:id="sidePanel" minWidth="260.0" spacing="10" styleClass="sidebar-pane" 
              BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25" left="20" right="20" top="25" />
            </padding>

            <children>
                <ImageView fx:id="imageLogo" fitHeight="125.0" fitWidth="117.0" preserveRatio="true" styleClass="clinic-logo">
                    <image>
                        <Image url="@../resource/images_icons/rmmcLogo.png" />
                    </image>
                    <effect>
                        <Glow level="0.14" />
                    </effect>
                </ImageView>

                <Label prefHeight="55.0" prefWidth="244.0" styleClass="sidebar-title" 
                       text="Ramon Magsaysay Memorial Colleges - Integrated School" 
                       textAlignment="CENTER" wrapText="true" />
                <Label alignment="CENTER" prefHeight="27.0" prefWidth="244.0" 
                       styleClass="sidebar-subtitle" 
                       text="Clinic Inventory Management System" />

                <Separator maxHeight="1.7976931348623157E308" maxWidth="-Infinity" 
                          minHeight="-Infinity" minWidth="-Infinity" prefHeight="44.0" 
                          prefWidth="244.0" styleClass="sidebar-separator" />

                <Label prefHeight="47.0" prefWidth="241.0" styleClass="menu-label" 
                       text="Navigation" />

                <Button fx:id="btnDashboard" alignment="CENTER" contentDisplay="TOP" 
                        onAction="#handleDashboard" prefHeight="40.0" maxWidth="Infinity" 
                        styleClass="nav-button" text=" Dashboard" textAlignment="CENTER" />
                <Button fx:id="btnRequestMedicine" alignment="CENTER" 
                        onAction="#handleRequestMedicine" prefHeight="40.0" maxWidth="Infinity" 
                        styleClass="nav-button" text="Request Medicine" />
                <Button fx:id="btnManageItems" alignment="CENTER" contentDisplay="CENTER" 
                        onAction="#handleManageItems" prefHeight="40.0" maxWidth="Infinity" 
                        styleClass="nav-button" text="Manage Items" />
                <Button fx:id="btnManageUsers" alignment="CENTER" 
                        onAction="#handleManageUsers" prefHeight="40.0" maxWidth="Infinity" 
                        styleClass="nav-button" text="Manage Users" />
                <Button fx:id="btnTransactions" alignment="CENTER" 
                        onAction="#handleTransactions" prefHeight="40.0" maxWidth="Infinity" 
                        styleClass="nav-button" text="Transactions" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator styleClass="sidebar-separator" />
                <Button fx:id="btnLogout" onAction="#handleLogout" prefHeight="37.0" 
                        maxWidth="Infinity" styleClass="logout-button" text="Log Out" />
            </children>
        </VBox>
    </left>

    <!-- ========== MAIN CONTENT PLACEHOLDER ========== -->
    <center>
        <!-- This AnchorPane will dynamically load other views -->
        <AnchorPane fx:id="mainContent" styleClass="dashboard-main-content" />
    </center>

    <stylesheets>
        <URL value="@../resource/dashboard.css" />
    </stylesheets>
</BorderPane>